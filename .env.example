# Copy to .env and fill in. Never commit real secrets.

# --- PostgreSQL / Supabase storage ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=whytee
# Full connection URL used by `psql -f supabase/schema.sql` and n8n credentials.
SUPABASE_DB_URL=postgresql://postgres:change-me@localhost:5432/whytee

# --- YouTube Data API v3 (channel video listing / metadata) ---
YOUTUBE_API_KEY=

# --- OpenRouter (LLM gateway: routing, embeddings, GEO analysis) ---
OPENROUTER_API_KEY=
# Cheap/free model for cleanup + keyword extraction
OPENROUTER_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b:free
# High-capability model for cross-time GEO synthesis
OPENROUTER_MODEL_DEEP=anthropic/claude-3.5-sonnet
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of authorised chat/user ids (security.md)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Transcription microservice ---
TRANSCRIBER_WHISPER_MODEL=base
# Comma/JSON list, e.g. ["zh-TW","en"]; empty uses service default
TRANSCRIBER_DEFAULT_LANGUAGES=

# --- Webshare residential proxy (optional, anti-rate-limit) ---
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# --- n8n ---
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
