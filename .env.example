# Copy to .env and fill in. Never commit real secrets.

# --- PostgreSQL / Supabase storage ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=whytee
# Full connection URL used by `psql -f supabase/schema.sql` and n8n credentials.
SUPABASE_DB_URL=postgresql://postgres:change-me@localhost:5432/whytee

# --- YouTube Data API v3 (channel video listing / metadata) ---
YOUTUBE_API_KEY=

# --- OpenRouter (LLM gateway: routing, embeddings, GEO analysis) ---
OPENROUTER_API_KEY=
# Cheap/free model for cleanup + keyword extraction
OPENROUTER_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b:free
# High-capability model for cross-time GEO synthesis
OPENROUTER_MODEL_DEEP=anthropic/claude-3.5-sonnet
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of authorised chat/user ids (security.md)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Transcription microservice ---
TRANSCRIBER_WHISPER_MODEL=base
# Comma/JSON list, e.g. ["zh-TW","en"]; empty uses service default
TRANSCRIBER_DEFAULT_LANGUAGES=
# Tier-2 backend: local (faster-whisper) | cloud (OpenAI-compatible Whisper)
#                 | elevenlabs (Scribe) | mlx (Apple Silicon)
TRANSCRIBER_STT_BACKEND=local
# Cloud Whisper (used when TRANSCRIBER_STT_BACKEND=cloud). OpenAI-compatible.
#   Groq:       https://api.groq.com/openai/v1   model: whisper-large-v3
#   OpenRouter / OpenAI: set base URL + model accordingly
TRANSCRIBER_CLOUD_STT_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBER_CLOUD_STT_MODEL=whisper-large-v3
TRANSCRIBER_CLOUD_STT_API_KEY=
# ElevenLabs Scribe (used when TRANSCRIBER_STT_BACKEND=elevenlabs)
TRANSCRIBER_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
TRANSCRIBER_ELEVENLABS_MODEL=scribe_v1
TRANSCRIBER_ELEVENLABS_API_KEY=
# Apple MLX Whisper (used when TRANSCRIBER_STT_BACKEND=mlx; Apple Silicon only)
TRANSCRIBER_MLX_MODEL=mlx-community/whisper-large-v3-mlx

# --- Webshare residential proxy (optional, anti-rate-limit) ---
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# --- n8n ---
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
