{
  "name": "02 - Real-time Monitor + GEO Analysis",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "youtube-websub",
        "options": { "rawBody": true }
      },
      "id": "websub",
      "name": "WebSub Webhook (PubSubHubbub)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "notes": "YouTube pushes an Atom XML body on new uploads. rawBody keeps the XML so the next node can parse it."
    },
    {
      "parameters": {
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "parse-xml",
      "name": "Parse Atom XML",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [400, 300],
      "notes": "Converts the PubSubHubbub Atom feed to JSON so yt:videoId is reachable."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "vid",
              "name": "videoId",
              "value": "={{ $json.feed.entry['yt:videoId'] }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-videoid",
      "name": "Extract videoId",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 300],
      "notes": "Confirm the path in the UI against a real push payload; Atom nesting can vary."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://transcriber:8000/transcribe",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_id\": \"{{ $json.videoId }}\",\n  \"languages\": [\"zh-TW\", \"en\"]\n}"
      },
      "id": "transcribe",
      "name": "Transcription Microservice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300],
      "notes": "If TRANSCRIBER_API_KEY is set, add an Authorization: Bearer header credential."
    },
    {
      "parameters": {
        "modelId": "={{ $env.OPENROUTER_MODEL_FAST }}",
        "messages": { "values": [
          { "role": "system", "content": "Extract the core entities and keywords from this transcript as a short comma-separated list, to be used as a semantic search query." },
          { "role": "user", "content": "={{ $json.text }}" }
        ] }
      },
      "id": "keywords",
      "name": "OpenRouter - Keyword Extraction (fast)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [1000, 300],
      "notes": "Use an OpenAI credential whose Base URL is overridden to https://openrouter.ai/api/v1."
    },
    {
      "parameters": {
        "mode": "load",
        "prompt": "={{ $json.message ? $json.message.content : $json.text }}",
        "topK": 6,
        "options": { "queryName": "match_documents" }
      },
      "id": "rag",
      "name": "Supabase Vector Store (Retrieve)",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1,
      "position": [1200, 300],
      "notes": "Semantic search over historical corpus using the extracted keywords. Needs an Embeddings sub-node."
    },
    {
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            { "fieldToAggregate": "document.pageContent", "renameField": true, "outputFieldName": "history" }
          ]
        },
        "options": {}
      },
      "id": "aggregate-history",
      "name": "Aggregate Retrieved History",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1400, 300],
      "notes": "Collapses the retrieved document excerpts into a single 'history' list for the prompt."
    },
    {
      "parameters": {
        "modelId": "={{ $env.OPENROUTER_MODEL_DEEP }}",
        "messages": { "values": [
          { "role": "system", "content": "You are a media-intelligence analyst. Compare the NEW transcript against the RETRIEVED historical excerpts. Respond ONLY with strict JSON: {\"goal\":\"\",\"execution\":\"\",\"outcome\":\"\",\"historical_evolution\":\"\"}." },
          { "role": "user", "content": "=NEW:\n{{ $('Transcription Microservice').item.json.text }}\n\nHISTORY:\n{{ $json.history }}" }
        ] }
      },
      "id": "geo",
      "name": "OpenRouter - GEO Synthesis (deep)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [1600, 300],
      "notes": "GEO = Goal / Execution / Outcome / Historical Evolution. Transcript is pulled from the Transcription node so it survives the keyword step."
    },
    {
      "parameters": {
        "mode": "insert",
        "options": { "queryName": "match_documents" }
      },
      "id": "store",
      "name": "Supabase Vector Store (Roll-forward insert)",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1,
      "position": [1800, 200],
      "notes": "Insert the new transcript chunks so the corpus keeps growing. Needs an Embeddings sub-node."
    },
    {
      "parameters": {
        "model": "={{ $env.OPENROUTER_EMBEDDING_MODEL }}",
        "options": {}
      },
      "id": "embeddings",
      "name": "Embeddings (OpenRouter)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [1500, 480],
      "notes": "Shared by retrieve + insert; model/dimension must match vector(1536) in schema.sql."
    },
    {
      "parameters": {
        "workflowId": "03 - Format & Deliver"
      },
      "id": "deliver",
      "name": "Execute Workflow 03 (Deliver)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1800, 360]
    }
  ],
  "connections": {
    "WebSub Webhook (PubSubHubbub)": { "main": [[{ "node": "Parse Atom XML", "type": "main", "index": 0 }]] },
    "Parse Atom XML": { "main": [[{ "node": "Extract videoId", "type": "main", "index": 0 }]] },
    "Extract videoId": { "main": [[{ "node": "Transcription Microservice", "type": "main", "index": 0 }]] },
    "Transcription Microservice": { "main": [[{ "node": "OpenRouter - Keyword Extraction (fast)", "type": "main", "index": 0 }]] },
    "OpenRouter - Keyword Extraction (fast)": { "main": [[{ "node": "Supabase Vector Store (Retrieve)", "type": "main", "index": 0 }]] },
    "Supabase Vector Store (Retrieve)": { "main": [[{ "node": "Aggregate Retrieved History", "type": "main", "index": 0 }]] },
    "Aggregate Retrieved History": { "main": [[{ "node": "OpenRouter - GEO Synthesis (deep)", "type": "main", "index": 0 }]] },
    "Embeddings (OpenRouter)": { "ai_embedding": [[
      { "node": "Supabase Vector Store (Retrieve)", "type": "ai_embedding", "index": 0 },
      { "node": "Supabase Vector Store (Roll-forward insert)", "type": "ai_embedding", "index": 0 }
    ]] },
    "OpenRouter - GEO Synthesis (deep)": { "main": [[
      { "node": "Supabase Vector Store (Roll-forward insert)", "type": "main", "index": 0 },
      { "node": "Execute Workflow 03 (Deliver)", "type": "main", "index": 0 }
    ]] }
  },
  "settings": { "executionOrder": "v1" }
}
